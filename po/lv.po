#: src/gss_err.c:24
msgid "Unknown Error"
msgstr "Nezināma kļūda"

#. ERR_DECODE
#: src/gss_err.c:25
msgid "Failed to decode data"
msgstr "Neizdevās dekodēt datus"

#. ERR_ENCODE
#: src/gss_err.c:26
msgid "Failed to encode data"
msgstr "Neizdevās kodēt datus"

#. ERR_CRYPTO
#: src/gss_err.c:27
msgid "Crypto routine failure"
msgstr "Kriptogrāfiskās funkcijas kļūme"

#. ERR_NOARG
#: src/gss_err.c:28
msgid "A required argument is missing"
msgstr "Trūkst obligāta argumenta"

#. ERR_BADARG
#: src/gss_err.c:29
msgid "Invalid value in argument"
msgstr "Nederīga argumenta vērtība"

#. ERR_NONAME
#: src/gss_err.c:30
msgid "Name is empty"
msgstr "Nosaukums ir tukšs"

#. ERR_NOSRVNAME
#: src/gss_err.c:31
msgid "Not a server name"
msgstr "Nav servera nosaukums"

#. ERR_NOUSRNAME
#: src/gss_err.c:32
msgid "Not a user name"
msgstr "Nav lietotājvārds"

#. ERR_BADLMLEVEL
#: src/gss_err.c:33
msgid "Bad LM compatibility Level"
msgstr "Nederīgs LM savietojamības līmenis"

#. ERR_IMPOSSIBLE
#: src/gss_err.c:34
msgid "An impossible error occurred"
msgstr "Radās neiespējama kļūda"

#. ERR_BADCTX
#: src/gss_err.c:35
msgid "Invalid or incomplete context"
msgstr "Nederīgs vai nepilnīgs konteksts"

#. ERR_WRONGCTX
#: src/gss_err.c:36
msgid "Wrong context type"
msgstr "Nepareizs konteksta tips"

#. ERR_WRONGMSG
#: src/gss_err.c:37
msgid "Wrong message type"
msgstr "Nepareizs ziņojuma tips"

#. ERR_REQNEGFLAG
#: src/gss_err.c:38
msgid "A required Negotiate flag was not provided"
msgstr "Nav norādīts obligāts Negotiate karogs"

#. ERR_FAILNEGFLAGS
#: src/gss_err.c:39
msgid "Failed to negotiate a common set of flags"
msgstr "Neizdevās vienoties par kopīgu karogu kopu"

#. ERR_BADNEGFLAGS
#: src/gss_err.c:40
msgid "Invalid combinations of negotiate flags"
msgstr "Nederīgas Negotiate karogu kombinācijas"

#. ERR_NOSRVCRED
#: src/gss_err.c:41
msgid "Not a server credential type"
msgstr "Nav servera akreditācijas datu tips"

#. ERR_NOUSRCRED
#: src/gss_err.c:42
msgid "Not a user credential type"
msgstr "Nav lietotāja akreditācijas datu tips"

#. ERR_BADCRED
#: src/gss_err.c:43
msgid "Invalid or unknown credential"
msgstr "Nederīgi vai nezināmi akreditācijas dati"

#. ERR_NOTOKEN
#: src/gss_err.c:44
msgid "Empty or missing token"
msgstr "Tukšs vai trūkstošs marķieris"

#. ERR_NOTSUPPORTED
#: src/gss_err.c:45
msgid "Feature not supported"
msgstr "Funkcija netiek atbalstīta"

#. ERR_NOTAVAIL
#: src/gss_err.c:46
msgid "Feature not available"
msgstr "Funkcija nav pieejama"

#. ERR_NAMETOOLONG
#: src/gss_err.c:47
msgid "Name is too long"
msgstr "Nosaukums ir pārāk garš"

#. ERR_NOBINDINGS
#: src/gss_err.c:48
msgid "Required channel bingings are not available"
msgstr "Nepieciešamās kanāla sasaistes nav pieejamas"

#. ERR_TIMESKEW
#: src/gss_err.c:49
msgid "Server and client clocks are too far apart"
msgstr "Servera un klienta pulksteņi pārāk atšķiras"

#. ERR_EXPIRED
#: src/gss_err.c:50
msgid "Expired"
msgstr "Derīguma termiņš beidzies"

#. ERR_KEYLEN
#: src/gss_err.c:51
msgid "Invalid key length"
msgstr "Nederīgs atslēgas garums"

#. ERR_NONTLMV1
#: src/gss_err.c:52
msgid "NTLM version 1 not allowed"
msgstr "NTLM 1. versija nav atļauta"

#. ERR_NOUSRFOUND
#: src/gss_err.c:53
msgid "User not found"
msgstr "Lietotājs nav atrasts"
